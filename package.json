{
  "name": "student-management-debug",
  "version": "1.0.0",
  "description": "Student Management System for a debugging competition - clean master build with a bug-injection generator",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:clean": "node server.js",
    "start:buggy": "node teams/common-all15/server.js",
    "setup:buggy": "npm install --prefix teams/common-all15",
    "setup": "npm install && npm install --prefix teams/common-all15",
    "generate": "node tools/generate.js",
    "smoke-test": "node tools/smoke-test.js",
    "smoke-test:buggy": "node tools/smoke-test.js http://localhost:3000"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "license": "MIT"
}
